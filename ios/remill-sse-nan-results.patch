 namespace {
 
+// SSE/AVX arithmetic uses the first NaN operand, quieted, unlike the
+// host ARM signaling-NaN priority. Keep this local to binary SSE arithmetic:
+// x87, min/max, comparisons and conversions have separate rules. This fixes
+// result bits only; it does not implement MXCSR exception/trap bookkeeping.
+template <typename T, typename U>
+ALWAYS_INLINE static T X86SSEBinaryResult(T lhs, T rhs, T result,
+                                       U absolute_mask, U exponent, U quiet,
+                                       U indefinite) {
+  static_assert(sizeof(T) == sizeof(U), "Matching FP and integer widths");
+  U left, right, bits;
+  __builtin_memcpy(&left, &lhs, sizeof(left));
+  __builtin_memcpy(&right, &rhs, sizeof(right));
+  __builtin_memcpy(&bits, &result, sizeof(bits));
+  if ((left & absolute_mask) > exponent) {
+    bits = left | quiet;
+  } else if ((right & absolute_mask) > exponent) {
+    bits = right | quiet;
+  } else if ((bits & absolute_mask) > exponent) {
+    // Invalid arithmetic without a NaN source returns negative indefinite.
+    bits = indefinite;
+  }
+  __builtin_memcpy(&result, &bits, sizeof(result));
+  return result;
+}
+
+ALWAYS_INLINE static float32_t X86SSEBinaryResult(float32_t lhs, float32_t rhs,
+                                               float32_t result) {
+  return X86SSEBinaryResult(lhs, rhs, result, uint32_t(0x7fffffff),
+                            uint32_t(0x7f800000), uint32_t(0x00400000),
+                            uint32_t(0xffc00000));
+}
+
+ALWAYS_INLINE static float64_t X86SSEBinaryResult(float64_t lhs, float64_t rhs,
+                                               float64_t result) {
+  return X86SSEBinaryResult(lhs, rhs, result, uint64_t(0x7fffffffffffffff),
+                            uint64_t(0x7ff0000000000000),
+                            uint64_t(0x0008000000000000),
+                            uint64_t(0xfff8000000000000));
+}
+
+#define MAKE_X86_SSE_BINARY(op) \
+  template <typename T> \
+  ALWAYS_INLINE static T X86SSE##op(T lhs, T rhs) { \
+    return X86SSEBinaryResult(lhs, rhs, F##op(lhs, rhs)); \
+  } \
+  template <typename T> \
+  ALWAYS_INLINE static T X86SSE##op##Vector(const T &lhs, const T &rhs) { \
+    T result{}; \
+    _Pragma("unroll") for (auto i = 0UL; i < NumVectorElems(lhs); ++i) { \
+      result.elems[i] = X86SSE##op(lhs.elems[i], rhs.elems[i]); \
+    } \
+    return result; \
+  }
+
+MAKE_X86_SSE_BINARY(Add)
+MAKE_X86_SSE_BINARY(Sub)
+MAKE_X86_SSE_BINARY(Mul)
+MAKE_X86_SSE_BINARY(Div)
+#undef MAKE_X86_SSE_BINARY
+
+
