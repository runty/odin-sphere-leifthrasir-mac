+++ b/lib/Arch/X86/Semantics/SSE.cpp
@@ -2983,3 +2983,5 @@
 IF_AVX(DEF_ISEL(VMAXPS_XMMdq_XMMdq_XMMdq) = PackedMax128<VV128W>;)
 IF_AVX(DEF_ISEL(VSQRTPS_XMMdq_XMMdq) = PackedSqrt128;)
 
+
+IF_AVX(DEF_ISEL(VMINPS_YMMqq_YMMqq_YMMqq) = PackedMinMax32<false, VV256W, V256>;)
