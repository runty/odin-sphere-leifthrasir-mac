+// Deterministic (V)RCPPS approximation within the ISA relative-error bound.
+// Integer rounding avoids host FP modes/exceptions. Input denormals are signed
+// zero, tiny results flush to signed zero, and NaNs retain payload/sign and quiet.
+// This is not a bit-exact model of any particular processor's approximation LUT.
+namespace {
+ALWAYS_INLINE static uint32_t ReciprocalSingleBits(uint32_t bits) {
+  const uint32_t sign = bits & 0x80000000u;
+  const uint32_t exponent = (bits >> 23) & 255u;
+  const uint32_t fraction = bits & 0x7fffffu;
+  if (!exponent) return sign | 0x7f800000u;
+  if (exponent == 255u) return fraction ? bits | 0x00400000u : sign;
+  const uint64_t denominator = 0x800000u | fraction;
+  const uint64_t numerator = uint64_t(1) << 47;
+  uint64_t quotient = numerator / denominator;
+  const uint64_t remainder = numerator % denominator;
+  if (2 * remainder > denominator || (2 * remainder == denominator && (quotient & 1))) ++quotient;
+  int output_exponent = 253 - static_cast<int>(exponent);
+  if (quotient == 0x1000000u) { quotient >>= 1; ++output_exponent; }
+  if (output_exponent <= 0) return sign;
+  return sign | (static_cast<uint32_t>(output_exponent) << 23) | (static_cast<uint32_t>(quotient) & 0x7fffffu);
+}
+template <typename D, typename S>
+DEF_SEM(RCPPS, D dst, S src) {
+  const auto input = UReadV32(src);
+  auto result = UClearV32(UReadV32(dst));
+  _Pragma("unroll") for (size_t i = 0; i < NumVectorElems(input); ++i)
+    result = UInsertV32(result, i, ReciprocalSingleBits(UExtractV32(input, i)));
+  UWriteV32(dst, result);
+  return memory;
+}
+}
+DEF_ISEL(RCPPS_XMMps_XMMps) = RCPPS<V128W, V128>;
+DEF_ISEL(RCPPS_XMMps_MEMps) = RCPPS<V128W, MV128>;
+IF_AVX(DEF_ISEL(VRCPPS_XMMdq_XMMdq) = RCPPS<VV128W, V128>;)
+IF_AVX(DEF_ISEL(VRCPPS_XMMdq_MEMdq) = RCPPS<VV128W, MV128>;)
+IF_AVX(DEF_ISEL(VRCPPS_YMMqq_YMMqq) = RCPPS<VV256W, V256>;)
+IF_AVX(DEF_ISEL(VRCPPS_YMMqq_MEMqq) = RCPPS<VV256W, MV256>;)
