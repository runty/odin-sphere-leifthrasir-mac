+// 8615:1857 PACKSSWB PACKSSWB_MMXq_MMXq MMX MMX PENTIUMMMX ATTRIBUTES: HALF_WIDE_OUTPUT NOTSX
+namespace {
+template <typename D, typename S1, typename S2>
+DEF_SEM(PBLENDW, D dst, S1 src1, S2 src2, I8 immediate) {
+  auto first = UReadV16(src1);
+  auto second = UReadV16(src2);
+  auto result = UClearV16(UReadV16(dst));
+  auto mask = Read(immediate);
+  _Pragma("unroll") for (size_t i = 0; i < NumVectorElems(first); ++i) {
+    auto value = (mask & (1u << (i % 8))) ? UExtractV16(second, i) : UExtractV16(first, i);
+    result = UInsertV16(result, i, value);
+  }
+  UWriteV16(dst, result);
+  return memory;
+}
+template <typename D, typename S1, typename S2>
+DEF_SEM(PACKUSDW, D dst, S1 src1, S2 src2) {
+  auto first = SReadV32(src1);
+  auto second = SReadV32(src2);
+  auto result = UClearV16(UReadV16(dst));
+  _Pragma("unroll") for (size_t i = 0; i < NumVectorElems(first); ++i) {
+    int32_t a = SExtractV32(first, i);
+    int32_t b = SExtractV32(second, i);
+    uint16_t a_word = static_cast<uint16_t>(std::min<int32_t>(65535, std::max<int32_t>(0, a)));
+    uint16_t b_word = static_cast<uint16_t>(std::min<int32_t>(65535, std::max<int32_t>(0, b)));
+    const size_t lane = (i / 4) * 8 + i % 4;
+    result = UInsertV16(result, lane, a_word);
+    result = UInsertV16(result, lane + 4, b_word);
+  }
+  UWriteV16(dst, result);
+  return memory;
+}
+}
