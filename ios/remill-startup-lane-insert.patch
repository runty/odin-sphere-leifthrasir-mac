--- a/lib/Arch/X86/Semantics/SSE.cpp
+++ b/lib/Arch/X86/Semantics/SSE.cpp
@@ -2747,3 +2747,34 @@
 DEF_ISEL(ROUNDSD_XMMq_MEMq_IMMb) = ROUND_SD<V128W, MV64>;
 IF_AVX(DEF_ISEL(VROUNDSD_XMMdq_XMMdq_XMMq_IMMb) = ROUND_SD<VV128W, V128>;)
 IF_AVX(DEF_ISEL(VROUNDSD_XMMdq_XMMdq_MEMq_IMMb) = ROUND_SD<VV128W, MV64>;)
+
+namespace {
+template <typename S>
+DEF_SEM(VPINSRB, VV128W dst, V128 src1, S src2, I8 immediate) {
+  auto result = UReadV8(src1);
+  auto value = static_cast<uint8_t>(Read(src2));
+  result = UInsertV8(result, Read(immediate) & 15, value);
+  UWriteV8(dst, result);
+  return memory;
+}
+template <typename S>
+DEF_SEM(VPINSRD, VV128W dst, V128 src1, S src2, I8 immediate) {
+  auto result = UReadV32(src1);
+  auto value = static_cast<uint32_t>(Read(src2));
+  result = UInsertV32(result, Read(immediate) & 3, value);
+  UWriteV32(dst, result);
+  return memory;
+}
+template <typename D>
+DEF_SEM(VEXTRACTPS, D dst, V128 src, I8 immediate) {
+  auto value = UExtractV32(UReadV32(src), Read(immediate) & 3);
+  WriteZExt(dst, value);
+  return memory;
+}
+}  // namespace
+IF_AVX(DEF_ISEL(VPINSRB_XMMdq_XMMdq_GPR32d_IMMb) = VPINSRB<R32>;)
+IF_AVX(DEF_ISEL(VPINSRB_XMMdq_XMMdq_MEMb_IMMb) = VPINSRB<M8>;)
+IF_AVX(DEF_ISEL(VPINSRD_XMMdq_XMMdq_GPR32d_IMMb) = VPINSRD<R32>;)
+IF_AVX(DEF_ISEL(VPINSRD_XMMdq_XMMdq_MEMd_IMMb) = VPINSRD<M32>;)
+IF_AVX(DEF_ISEL(VEXTRACTPS_GPR32_XMMdq_IMMb) = VEXTRACTPS<R32W>;)
+IF_AVX(DEF_ISEL(VEXTRACTPS_MEMd_XMMdq_IMMb) = VEXTRACTPS<M32W>;)
