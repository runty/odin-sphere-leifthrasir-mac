+namespace {
+template <typename D, typename S1, typename S2, typename M>
+DEF_SEM(PBLENDVB, D dst, S1 src1, S2 src2, M mask) {
+  auto first = UReadV8(src1);
+  auto second = UReadV8(src2);
+  auto selection = UReadV8(mask);
+  auto result = UClearV8(UReadV8(dst));
+  _Pragma("unroll") for (size_t i = 0; i < NumVectorElems(first); ++i) {
+    // Only each mask byte's high bit selects the second source.
+    bool choose_second = (UExtractV8(selection, i) & 0x80_u8) != 0;
+    result = UInsertV8(result, i, Select(choose_second,
+        UExtractV8(second, i), UExtractV8(first, i)));
+  }
+  UWriteV8(dst, result);
+  return memory;
+}
