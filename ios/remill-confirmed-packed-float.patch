+IF_AVX(DEF_ISEL(VUNPCKHPS_YMMqq_YMMqq_YMMqq) = PackedUnpackHPS;)
+IF_AVX(DEF_ISEL(VUNPCKLPD_YMMqq_YMMqq_YMMqq) = PackedUnpackLPD;)
+IF_AVX(DEF_ISEL(VUNPCKHPD_YMMqq_YMMqq_YMMqq) = PackedUnpackHPD;)
+IF_AVX(DEF_ISEL(VMINPS_YMMqq_YMMqq_MEMqq) = PackedMinMax32<false, VV256W, MV256>;)
+IF_AVX(DEF_ISEL(VMAXPS_YMMqq_YMMqq_YMMqq) = PackedMinMax32<true, VV256W, V256>;)
+IF_AVX(DEF_ISEL(VMAXPS_XMMdq_XMMdq_XMMdq) = PackedMax128<VV128W>;)
+IF_AVX(DEF_ISEL(VSQRTPS_XMMdq_XMMdq) = PackedSqrt128;)
